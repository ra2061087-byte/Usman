{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Student record in the Jamia",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "fatherName": { "type": "string" },
        "rollNo": { "type": "string" },
        "studentClass": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "fatherName", "rollNo", "studentClass", "email", "password", "createdAt"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Daily attendance record",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["present", "absent", "leave"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "date", "status", "updatedAt"]
    },
    "finance": {
      "title": "Finance",
      "description": "Income or expense record",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "category": { "type": "string" }
      },
      "required": ["type", "amount", "description", "date"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "student",
      "description": "Collection of students"
    },
    "/attendance/{attendanceId}": {
      "schema": "attendance",
      "description": "Attendance records"
    },
    "/finance/{financeId}": {
      "schema": "finance",
      "description": "Financial records"
    }
  }
}
