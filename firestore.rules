rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 4. Admin Role Check
    // Bootstrapped Admin: ra2061087@gmail.com
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ra2061087@gmail.com' && request.auth.token.email_verified == true
        || exists(/databases/$(database)/documents/roles/$(request.auth.uid))
      );
    }

    // 2. Validation Blueprints
    function isValidStudent(data) {
      return data.keys().hasAll(['fullName', 'fatherName', 'rollNo', 'studentClass', 'email', 'password', 'createdAt'])
        && data.keys().size() == 7
        && data.fullName is string && data.fullName.size() <= 100
        && data.fatherName is string && data.fatherName.size() <= 100
        && data.rollNo is string && data.rollNo.size() <= 20
        && data.studentClass is string && data.studentClass.size() <= 50
        && data.email is string && data.email.size() <= 100
        && data.password is string && data.password.size() <= 100
        && data.createdAt == request.time;
    }

    // 1. & 8. Collection Rules
    match /students/{studentId} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == studentId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidStudent(incoming()) && isValidId(studentId);
      allow update: if isAdmin() && isValidStudent(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'fatherName', 'studentClass', 'phone', 'address', 'email', 'password'])
      );
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read, write: if isAdmin();
    }

    match /finance/{financeId} {
      allow read, write: if isAdmin();
    }

    match /roles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
